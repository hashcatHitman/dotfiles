# Only use HTTPS
--proto =https

# Use TLS 1.3 or greater
--tlsv1.3

# Prefer HTTP/3. In the future, I'll probably switch to `--http3-only`
# The version of `curl` in Fedora 44 is built without HTTP/3 support, but it
# looks like it will be available in the version of `curl` available in Fedora
# 45.
# --http3

# Explicitly request the progress meter (which is the default anyway)
--progress-meter

# Show an error message, even when using `--silent`.
--show-error
